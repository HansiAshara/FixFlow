{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AiIssueAnalysisResponse",
  "type": "object",
  "required": ["category", "requiredSkills", "severity", "riskLevel", "tags", "confidence"],
  "properties": {
    "category": {
      "type": "string",
      "enum": ["Plumbing", "Electrical", "HVAC", "Carpentry", "Appliances", "Roofing", "Masonry", "GeneralMaintenance"]
    },
    "requiredSkills": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "severity": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
    },
    "riskLevel": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH", "HAZARDOUS"]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    }
  },
  "additionalProperties": false
}
