# ==============================================================================
# FixFlow Environment Configuration Template (.env.example)
# Copy this file to .env for local Docker Compose or standalone development.
# NEVER commit real credentials, passwords, or production keys.
# ==============================================================================

# General
ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development
NODE_ENV=development

# Database (PostgreSQL)
POSTGRES_DB=fixflow_db
POSTGRES_USER=fixflow_app
POSTGRES_PASSWORD=fixflow_local_dev_password_change_in_prod
POSTGRES_PORT=5432
# Connection string used by API and Worker
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=fixflow_db;Username=fixflow_app;Password=fixflow_local_dev_password_change_in_prod

# Messaging (RabbitMQ)
RABBITMQ_DEFAULT_USER=fixflow_mq
RABBITMQ_DEFAULT_PASS=fixflow_mq_local_password
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RabbitMq__Host=localhost
RabbitMq__Port=5672
RabbitMq__Username=fixflow_mq
RabbitMq__Password=fixflow_mq_local_password

# Authentication (JWT)
Jwt__Issuer=FixFlow.Api
Jwt__Audience=FixFlow.Web
Jwt__SecretKey=FixFlow_Super_Secure_Local_Development_Key_At_Least_32_Bytes_Long_2026!
Jwt__ExpiryMinutes=60
Jwt__RefreshTokenExpiryDays=7

# Local AI Engine (Ollama)
Ollama__BaseUrl=http://localhost:11434
Ollama__Model=llama3.2:3b
Ollama__TimeoutSeconds=60

# Frontend Settings (Vite / React)
VITE_API_BASE_URL=http://localhost:5000/api
VITE_APP_TITLE=FixFlow - Intelligent Issue & Technician Matching Platform
PORT=3000

# Backend Ports
API_PORT=5000
WORKER_PORT=5001
